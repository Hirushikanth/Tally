# Frontend environment variables.
# Copy this file to .env.local for local development.

# API base URL. Leave unset (or set to "/api") when the Vite dev proxy or a
# same-origin nginx reverse proxy handles /api — see vite.config.ts.
VITE_API_URL=/api

# Sentry DSN for error reporting. Optional — leave unset to disable Sentry
# (the app still works; render errors are only logged to the console).
# Create a project at https://sentry.io and copy its DSN here.
VITE_SENTRY_DSN=https://<key>@<org>.ingest.us.sentry.io/<project>
