# Proxies /api/* to the API service and strips the /api prefix (the backend
# has no global prefix). The file is envsubst'd by the nginx image entrypoint:
# set BACKEND_UPSTREAM to the API service URL (e.g. http://backend:3000).

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml font/woff2;

    # Hashed build assets: cache forever (the hash changes per deploy).
    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Small static files (favicon, icon sprite): short cache.
    location ~* \.(?:svg|ico|png|jpg|jpeg|webp|woff2?)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400";
    }

    # Same-origin API proxy.
    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # SPA fallback. index.html must not be cached aggressively.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
