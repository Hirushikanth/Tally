# Canonical env documentation lives in backend/.env.example.
# Copy backend/.env.example to backend/.env for development.
# This file mirrors it for convenience when the backend is run from the repo
# root. Keep the two .env.example files in sync.

# --- Required ---

DATABASE_URL=postgresql://YOUR_USER@localhost:5432/tally_dev
# Must be a long random string; >= 32 chars when NODE_ENV=production.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# --- Optional ---

# Access token lifetime (default: 15m).
JWT_EXPIRES_IN=15m
# Refresh token lifetime (default: 30d).
REFRESH_TOKEN_EXPIRES_IN=30d
# Server port (default: 3000).
PORT=3000
# Log level: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info
# Comma-separated allowed CORS origins (default: http://localhost:5173).
CORS_ORIGINS=http://localhost:5173
# Canonical frontend origin (default: none).
FRONTEND_URL=http://localhost:5173
# Sentry DSN for error reporting. Optional — leave unset to disable.
SENTRY_DSN=https://<key>@<org>.ingest.us.sentry.io/<project>
# development | test | production.
NODE_ENV=development
