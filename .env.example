# Copy to backend/.env and fill in values.
# DATABASE_URL: Neon pooled connection string (Phase 0 uses owner role for migrations).
# Phase 2 will introduce a restricted app_runtime role for runtime writes.
DATABASE_URL=postgresql://app_runtime:PASSWORD@HOST/DB?sslmode=require

# Required in Phase 3 (auth). Included here for consistency.
JWT_SECRET=change-me-in-production
