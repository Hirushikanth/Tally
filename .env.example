# Canonical env documentation lives in backend/.env.example.
# Copy backend/.env.example to backend/.env for development.
# This file is kept in sync for convenience when the backend is run from the repo root.

DATABASE_URL=postgresql://YOUR_USER@localhost:5432/tally_dev
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=3000
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
