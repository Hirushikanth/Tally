{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testMatch": [
    "<rootDir>/tests/*.e2e-spec.ts",
    "<rootDir>/test/*.e2e-spec.ts"
  ],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/test/setup-e2e.ts"],
  "maxWorkers": 1
}
