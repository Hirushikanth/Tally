# Copy to backend/.env and fill in values.
# .env files are git-ignored — never commit real credentials.

# --- Required ---

# PostgreSQL connection string (Neon pooled URL in production).
# In production use a restricted app_runtime role, not the project owner.
DATABASE_URL=postgresql://YOUR_USER@localhost:5432/tally_dev

# JWT signing secret. MUST be a long random string.
# Generate one with:  openssl rand -base64 48
# Minimum 32 characters when NODE_ENV=production (the app refuses to boot otherwise).
JWT_SECRET=change-me-to-a-long-random-string

# --- Optional ---

# Access token lifetime (jsonwebtoken format). Default: 15m
JWT_EXPIRES_IN=15m

# Refresh token lifetime (jsonwebtoken/ms format). Default: 30d
REFRESH_TOKEN_EXPIRES_IN=30d

# Server port. Default: 3000
PORT=3000

# Log level: fatal | error | warn | info | debug | trace | silent.
# Default: info (debug in development).
LOG_LEVEL=info

# Comma-separated list of allowed CORS origins. Default: http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Canonical frontend origin (CORS + future flows). Default: none
FRONTEND_URL=http://localhost:5173

# development | test | production. Default: development.
# In production the app refuses to boot without a strong JWT_SECRET.
NODE_ENV=development
